{
  "name": "failure-review-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed task outcome, efficiency, and attainment review pipeline for Codex sessions",
  "type": "module",
  "bin": {
    "failure-review": "./src/cli.js"
  },
