{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://failure-review-loop.local/schemas/proposal.schema.json",
  "title": "Issue Cluster Improvement Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_revision", "contract_bundle_hash", "run_id", "project_id", "improvement_target_ids", "proposals", "dispositions"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "contract_revision": { "const": "2026-07-24.contract-first.1" },
    "contract_bundle_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "improvement_target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/target_id" }
    },
    "proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposal" }
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/disposition" }
    }
  },
  "$defs": {
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "cluster_id": {
      "type": "string",
      "pattern": "^ic_[a-f0-9]{16}$"
    },
    "metric": {
      "enum": ["attainment_rate", "turn_count", "clarification_count", "repeated_clarification_count", "execution_attempt_count", "rework_count", "pattern_rate"]
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "issue_cluster_id", "instance_count", "problem_instance_ids", "evidence_ids", "root_cause", "target_id", "target_file", "target_location", "minimal_change", "behavior_before", "behavior_after", "expected_metric_effects", "side_effects", "scope_expansion_risk", "regression_tests"],
      "properties": {
        "proposal_id": { "type": "string", "pattern": "^pr_[a-zA-Z0-9_-]+$" },
        "issue_cluster_id": { "$ref": "#/$defs/cluster_id" },
        "instance_count": { "type": "integer", "minimum": 3 },
        "problem_instance_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^pi_[a-zA-Z0-9_-]+$" }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" }
        },
        "root_cause": { "type": "string", "minLength": 1 },
        "target_id": { "$ref": "#/$defs/target_id" },
        "target_file": { "type": "string", "minLength": 1 },
        "target_location": { "type": "string", "minLength": 1 },
        "minimal_change": { "type": "string", "minLength": 1 },
        "behavior_before": { "type": "string", "minLength": 1 },
        "behavior_after": { "type": "string", "minLength": 1 },
        "expected_metric_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "direction"],
            "properties": {
              "metric": { "$ref": "#/$defs/metric" },
              "direction": { "enum": ["increase", "decrease"] }
            }
          }
        },
        "side_effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "scope_expansion_risk": { "enum": ["none", "low", "medium", "high"] },
        "regression_tests": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["test_id", "kind", "given", "when", "then"],
            "properties": {
              "test_id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["original_failure", "adjacent_case"] },
              "given": { "type": "string", "minLength": 1 },
              "when": { "type": "string", "minLength": 1 },
              "then": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "disposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["issue_cluster_id", "status", "proposal_ids", "reason"],
          "properties": {
            "issue_cluster_id": { "$ref": "#/$defs/cluster_id" },
            "status": { "const": "proposed" },
            "proposal_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^pr_[a-zA-Z0-9_-]+$" }
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["issue_cluster_id", "status", "proposal_ids", "reason"],
          "properties": {
            "issue_cluster_id": { "$ref": "#/$defs/cluster_id" },
            "status": { "const": "no_supported_target" },
            "proposal_ids": { "type": "array", "maxItems": 0 },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
